; SPDX-License-Identifier: MIT OR Apache-2.0
; A first Soil port of arborist's pure evaluator.
;
; This slice reads the snapshot fixture and reproduces the counts for the
; checks that need only top-level repository fields. The Rust component stays
; the oracle; the goal is to grow this until report JSON is identical.

(defun ar/option (value key)
  (json/get-or value key nil))

(defun ar/member? (value values)
  (cond
    ((nil? values) #f)
    ((= value (first values)) #t)
    (else (ar/member? value (rest values)))))

(defun ar/slug (repo)
  (str (field repo :org) "/" (field repo :name)))

(defun ar/skip? (repo)
  (or (and (= (field repo :archived) #t) #t)
      (and (= (field repo :fork) #t) #t)))

(defun ar/check-ids ()
  (list "license" "ci" "ci-green" "release" "readme"
        "description" "active" "branches" "open-pulls"))

(defun ar/severity (id)
  (if (or (= id "license") (= id "ci") (= id "ci-green")
          (= id "readme")
          (= id "tracker"))
      "critical"
      "advisory"))

(defun ar/date-ms (text)
  (if (or (nil? text) (< (length text) 10)) nil
      (let ((parsed (date/parse-date (string-join (take 10 (string-chars text)) ""))))
        (if (ok? parsed) (value parsed) nil))))

(defun ar/days-between (from to)
  (date/floor-div (- to from) 86400000))

(defun ar/status (check repo collected)
  (cond
    ((= check "license")
      (let ((license (ar/option repo :license)))
        (if (and (string? license) (not (= license ""))) "pass" "fail")))
    ((= check "ci")
      (if (= 0 (length (or-empty (ar/option repo :workflows)))) "fail" "pass"))
    ((= check "ci-green")
      (let ((run (ar/option repo :latest_run)))
        (if (nil? run) "unknown"
            (let ((conclusion (field run :conclusion)))
              (cond ((= conclusion "success") "pass")
                    ((= conclusion "") "unknown")
                    (else "fail"))))))
    ((= check "release")
      (if (= 0 (or (ar/option repo :releases) 0)) "fail" "pass"))
    ((= check "readme")
      (let ((readme (ar/option repo :readme)))
        (cond
          ((nil? readme) "unknown")
          ((not (= (field readme :present) #t)) "fail")
          ((< (or (field readme :bytes) 0) 256) "fail")
          (else "pass"))))
    ((= check "description")
      (let ((description (ar/option repo :description)))
        (if (and (string? description) (not (= description ""))) "pass" "fail")))
    ((= check "active")
      (let ((pushed (ar/option repo :pushed_at)))
        (if (or (nil? pushed) (nil? collected)) "unknown"
            (let ((pushed-ms (ar/date-ms pushed))
                  (collected-ms (ar/date-ms collected)))
              (if (or (nil? pushed-ms) (nil? collected-ms)) "unknown"
                  (if (> (ar/days-between pushed-ms collected-ms) 90)
                      "fail"
                      "pass"))))))
    ((= check "branches")
      (if (> (or (ar/option repo :branches) 0) 50) "fail" "pass"))
    ((= check "open-pulls")
      (if (> (or (ar/option repo :open_pulls) 0) 10) "fail" "pass"))
    (else "unknown")))

(defun ar/empty-stats (checks)
  (map (lambda (check)
         (list (list :check check)
               (list :severity (ar/severity check))
               (list :pass 0)
               (list :fail 0)
               (list :unknown 0)
               (list :exempt 0)))
       checks))

(defun ar/inc (stats check status)
  (map (lambda (row)
         (if (= (field row :check) check)
             (assoc (keyword status)
               (+ 1 (field row (keyword status)))
               row)
             row))
       stats))

(defun ar/eval-repos (repos checks collected stats)
  (if (nil? repos)
      stats
      (let ((repo (first repos)))
        (if (ar/skip? repo)
            (ar/eval-repos (rest repos) checks collected stats)
            (ar/eval-repos (rest repos) checks collected
              (ar/eval-checks checks repo collected stats))))))

(defun ar/eval-checks (checks repo collected stats)
  (if (nil? checks)
      stats
      (let ((check (first checks)))
        (ar/eval-checks (rest checks) repo collected
          (ar/inc stats check (ar/status check repo collected))))))

(defun ar/scored (repos)
  (if (nil? repos) nil
      (if (ar/skip? (first repos))
          (ar/scored (rest repos))
          (cons (first repos) (ar/scored (rest repos))))))

(defun ar/skipped-count (repos)
  (if (nil? repos) 0
      (+ (if (ar/skip? (first repos)) 1 0)
         (ar/skipped-count (rest repos)))))

(defun ar/orgs (repos orgs)
  (if (nil? repos) orgs
      (let ((org (field (first repos) :org)))
        (if (ar/member? org orgs)
            (ar/orgs (rest repos) orgs)
            (ar/orgs (rest repos) (cons org orgs))))))

(defun ar/report (snapshot)
  (let ((repos (field snapshot :repos))
        (checks (ar/check-ids))
        (stats (ar/empty-stats (ar/check-ids))))
    (let ((stats (ar/eval-repos repos checks (ar/option snapshot :collected_at) stats)))
      (list
        (list :schema (or (field snapshot :schema) 1))
        (list :collected_at (ar/option snapshot :collected_at))
        (list :orgs (reverse (ar/orgs repos nil)))
        (list :summary
          (list
            (list :checked (length (or-empty (ar/scored repos))))
            (list :skipped (ar/skipped-count repos))
            (list :by_check stats)))))))

(defun main ()
  (let ((path (first (argv))))
    (let ((source (fs/read path)))
      (if (ok? source)
          (println (json/pretty (ar/report (json-decode (value source)))))
          (println (json-encode (list (list :error (str source)))))))))
